{
  "rules": {
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.uid === $uid)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "photoURL": {
          ".write": "auth != null && auth.uid === $uid && newData.isString() && newData.val().length <= 2048"
        }
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "characters": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "subjects": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "extracurriculars": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "classes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "students": {
      ".indexOn": ["parentId", "classId"],
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || (query.orderByChild == 'parentId' && query.equalTo == auth.uid))",
      "$studentId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || data.child('parentId').val() === auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
      }
    },
    "assessments": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$year_sem": {
        "$studentId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || root.child('students').child($studentId).child('parentId').val() === auth.uid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
        }
      }
    },
    "academic_grades": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$year_sem": {
        "$studentId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || root.child('students').child($studentId).child('parentId').val() === auth.uid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
        }
      }
    },
    "student_extracurriculars": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$year_sem": {
        "$studentId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || root.child('students').child($studentId).child('parentId').val() === auth.uid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
        }
      }
    },
    "cocurriculars": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$year_sem": {
        "$studentId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || root.child('students').child($studentId).child('parentId').val() === auth.uid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
        }
      }
    },
    "attendances": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$year_sem": {
        "$studentId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || root.child('students').child($studentId).child('parentId').val() === auth.uid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
        }
      }
    },
    "teacher_notes": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$year_sem": {
        "$studentId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || root.child('students').child($studentId).child('parentId').val() === auth.uid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
        }
      }
    },
    "parent_responses": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$year_sem": {
        "$studentId": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || root.child('students').child($studentId).child('parentId').val() === auth.uid)",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || root.child('students').child($studentId).child('parentId').val() === auth.uid)"
        }
      }
    },
    "observations": {
      ".indexOn": ["studentId"],
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu' || (query.orderByChild == 'studentId' && root.child('students').child(query.equalTo).child('parentId').val() == auth.uid))",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
    },
    "school_settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "teacher_attendance": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$dateStr": {
        "$teacherId": {
          ".read": "auth != null && (auth.uid === $teacherId || root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
          ".write": "auth != null && (auth.uid === $teacherId || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    "student_attendance_daily": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      "$dateStr": {
        "$classId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
          "$studentId": {
            ".validate": "newData.isString() && (newData.val() == 'H' || newData.val() == 'S' || newData.val() == 'I' || newData.val() == 'A')"
          }
        }
      }
    },
    "leave_requests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')"
    },

    "master": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "students": {
        ".indexOn": ["classId", "parentId"]
      },
      "classes": {
        ".indexOn": ["teacherId"]
      },
      "teachers": {
        ".indexOn": ["role", "status"]
      },
      "staff": {
        ".indexOn": ["role", "status"]
      }
    },
    "finance": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'finance')",
      "payments": {
        ".indexOn": ["studentId", "status", "dueDate"]
      },
      "student_bills": {
        ".indexOn": ["studentId", "status", "dueDate"]
      },
      "ledger": {
        ".indexOn": ["date", "type"]
      }
    },
    "curriculum": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'curriculum' || root.child('users').child(auth.uid).child('role').val() === 'guru')",
      "schedules": {
        ".indexOn": ["classId", "day"]
      },
      "reports": {
        ".indexOn": ["studentId", "academicYear"]
      }
    },
    "student_affairs": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'studentAffairs' || root.child('users').child(auth.uid).child('role').val() === 'guru')",
      "attendance": {
        ".indexOn": ["studentId", "date"]
      },
      "violations": {
        ".indexOn": ["studentId", "date"]
      },
      "achievements": {
        ".indexOn": ["studentId", "year"]
      }
    },
    "personnel": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'personnel')",
      "attendance": {
        ".indexOn": ["employeeId", "date"]
      },
      "leaveRequests": {
        ".indexOn": ["employeeId", "status"]
      }
    },
    "facilities": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() !== 'ortu')",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'facilities')",
      "assets": {
        ".indexOn": ["category", "status"]
      },
      "maintenance": {
        ".indexOn": ["assetId", "status"]
      }
    }
  }
}
